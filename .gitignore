# ChatGPT image worker — operator session material. NEVER commit (contains
# logged-in ChatGPT cookies / profile). Local-only, per-machine.
#
# The pattern is a PREFIX match on purpose: the worker creates one profile
# directory per account, suffixed with the email
# (static/.chatgpt_profile_<account>/). The bare `static/.chatgpt_profile/`
# below matched none of them, so ~513 MB of live cookies sat untracked-but-
# not-ignored — one `git add -A` away from being committed, and enough to
# block deploy.ps1's clean-checkout gate.
static/.chatgpt_profile*/
static/.chatgpt_cookies.json
# Same deal for the Gemini video worker's own Chrome profile (live Google
# session cookies). Prefix match so any per-account suffix is covered too.
static/.gemini_profile*/
# Per-job scratch (downloaded frames + rendered mp4s) from --serve mode.
static/.gemini_work/
# Dumped StreamGenerate responses from failed submits (diagnostics only).
static/.gemini_debug/
# Same for the AI Studio decode worker: live Google session + failure dumps
# (DOM, screenshots, captured response bodies). Never knowledge, never shared.
static/.aistudio_profile*/
static/.aistudio_debug/
static/.submit_storage_state.json
# Written at runtime by image_worker.py (see _worker_chrome_channel) — records
# which Chrome channel this machine's worker uses. Per-machine, not shared.
static/.worker_chrome_channel
# Local scratch job list; carries absolute operator paths, not a repo template.
static/chatgpt_jobs.example.json
# v943.8 — the charswap evidence file (see charswap_write_diag). Runtime
# observation from whichever machine ran the worker, appended per clip and
# never rotated. It is diagnostics, not knowledge. Ignored because this repo
# is checked out on a SHARED working tree where a `git add -A` sweeps whatever
# is untracked (root CLAUDE.md §16.5), and a growing jsonl under static/ is
# exactly the sort of file that gets committed by accident.
static/charswap_diag.jsonl

# Local runtime store — sqlite db, uploads, generated images, exports. Created
# on first run; never shared (production keeps its own on Render + R2).
data/

# Local scratch produced while debugging jobs/exports. One-off operator
# artifacts, none of them inputs to the app.
cut5.mp4
graphify-out/
assignment.json
file_to_job.json
file_to_job2.json
folder_index.json
job_fps.json
local_fp.b64
local_fp2.b64
local_fps.json
proven_links.json
proven_links_all.json
proven_links_final.json
recon_data.json
recon_min.json
reconcile.json
revert_mine.json
stranded.json
to_revert.json

# Byte-compiled files. Produced by any local `import main` check (the deploy
# discipline requires one before every push) and never wanted in the repo.
__pycache__/
*.pyc

# Scoped deploy acknowledgment written by `check_deploy_safety.py --ack`.
# Valid only for one exact tree + loss set (self-stales on any new commit).
# Must be ignored so deploy.ps1's clean-checkout gate does not see it.
.deploy_ack.json
