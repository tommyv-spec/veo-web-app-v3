#!/bin/sh
# DEPLOY GATE for the code submodule (tracked copy).
#
# A push to main IS a production deploy. This is the last moment anything can be
# checked, and it is the moment two near-misses happened in two days:
#   * a sync from a stale branch dropped 21 lines of main-only content
#   * the fix for it dropped one more
# Commit hooks did not catch either, because both were pushed from worktrees.
#
# WHAT IT DOES when (and only when) the push target is main:
#   * runs check_deploy_safety.py — blocks if the pushed tree loses any line that
#     origin/main has, deletes a text file, or ships a .py that does not parse
#   * prints the exact verify command to run afterwards
#
# Deliberate removals: `git push --no-verify`, or run the check yourself with
# --allow-loss first to see it acknowledged.
#
# PREFERRED since 2026-08-03: `python check_deploy_safety.py --ack` — writes a
# scoped .deploy_ack.json bound to that exact tree + exact loss set. The
# checker this hook runs honors it, so the hooked push passes with every other
# check still enforced. It self-stales on any new commit; no --no-verify.
#
# INSTALL (from the wiki repo root):
#   cp code/git-hooks/pre-push-code .git/modules/code/hooks/pre-push
#   chmod +x .git/modules/code/hooks/pre-push
#
# A main push fails closed if Python, the protected checker, or the remote base
# cannot be read. A broken guard must never become permission to deploy.

remote="$1"

targets_main=""
base_main=""
cr=$(printf '\r')
while read local_ref local_sha remote_ref remote_sha; do
  local_sha=${local_sha%"$cr"}
  remote_sha=${remote_sha%"$cr"}
  remote_ref=${remote_ref%"$cr"}
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/main)
      targets_main="$local_sha"
      base_main="$remote_sha"
      ;;
  esac
done

[ -z "$targets_main" ] && exit 0
zero=0000000000000000000000000000000000000000

block() {
  echo ""
  echo "PUSH BLOCKED — deploy safety could not be proved: $1"
  echo "Do not bypass this for an infrastructure error. Fix the guard and retry."
  exit 1
}

[ "$targets_main" = "$zero" ] && block "deleting production main is not allowed"
[ -z "$base_main" ] && block "the remote main SHA was not provided"
[ "$base_main" = "$zero" ] && block "creating production main without a protected base is not allowed"
command -v python >/dev/null 2>&1 || block "python is unavailable"

git fetch -q "$remote" main 2>/dev/null || block "remote main could not be refreshed"
git cat-file -e "${base_main}^{commit}" 2>/dev/null || block "remote main ${base_main} is unreadable"

# Always run the checker from the protected remote-main commit. A stale branch
# may contain an older or weakened checker; candidate code is not the authority
# that decides whether the candidate itself may deploy.
script=$(git show "${base_main}:check_deploy_safety.py" 2>/dev/null)
[ -z "$script" ] && block "protected main has no deploy checker"
out=$(printf '%s' "$script" | python - --ref "$targets_main" --main "$base_main" 2>&1)
status=$?

case "$out" in
  *"DEPLOY SAFETY"*) ;;
  *) block "the deploy checker did not complete" ;;
esac
echo "$out"

if [ $status -ne 0 ]; then
  echo ""
  echo "PUSH BLOCKED — this deploy would lose content or ship a broken module."
  echo "Deliberate? first run the protected checker yourself with --allow-loss"
  echo "then push with --no-verify."
  echo "PREFERRED: python check_deploy_safety.py --ack   (scoped acknowledgment,"
  echo "self-stales on any new commit) — then push normally; this hook honors it."
  exit 1
fi

# ---------------------------------------------------------------------------
# FEATURE CHECKS (added 2026-08-28)
#
# Deploy safety above proves the push loses no content and ships parseable
# modules. It says nothing about whether the FEATURES still work. These two
# steps close that, for every session, without anyone remembering to.
#
# Neither one can block on infrastructure: if node or the checks are missing
# the push proceeds with a loud note. The content gate above is the thing that
# fails closed; this part is quality feedback, and a quality check that blocks
# a deploy because a tool is absent gets deleted, taking the signal with it.
# A check that RUNS and FAILS does block -- that is a real answer.
# ---------------------------------------------------------------------------

if [ -f "tests/ui/run_ui_checks.mjs" ] && command -v node >/dev/null 2>&1; then
  echo ""
  echo "running UI checks on the tree being pushed..."
  if node tests/ui/run_ui_checks.mjs --source local; then
    :
  else
    echo ""
    echo "PUSH BLOCKED - the UI checks failed on this tree."
    echo "Deploying this would ship a broken feature. Fix it, or run"
    echo "    node code/tests/ui/run_ui_checks.mjs --source local"
    echo "to see which check went red."
    exit 1
  fi
else
  echo "(UI checks skipped: node or tests/ui/run_ui_checks.mjs unavailable)"
fi

# Start the live verification in the background. It waits for the sha to go
# live, then re-runs the checks and the browser proof against the DELIVERED
# page and records a verdict. Replaces the printed "remember to verify" that
# nobody actioned. Never blocks: this runs AFTER the push either way.
if [ -f "../tools/spawn_watcher.py" ] && command -v python >/dev/null 2>&1; then
  echo ""
  python ../tools/spawn_watcher.py "${targets_main}" || true
  # Some changes cannot be judged at deploy time -- a caption fix, a prompt
  # change, a publish change. Register what will eventually prove them so the
  # deploy is not silently treated as verified. A commit can say so itself with
  # a "Proof: <what has to happen> | <the question>" trailer; otherwise the file
  # map guesses, and anything unmatched is reported as UNCOVERED.
  python ../tools/deploy_claims.py register "${targets_main}" || true
else
  echo ""
  echo "After the push, CONFIRM it (never assume):"
  echo "    python code/verify_deploy.py ${targets_main}"
fi
exit 0
